; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fishards"
run/main_scene="res://Scenes/MainMenu/MainMenu.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.482353, 0.607843, 0.666667, 1)
boot_splash/use_filter=false
boot_splash/image="res://Assets/Images/UI/MainMenu/splash.png"
config/icon="res://fishards_logo_2.png"
config/windows_native_icon="res://fishards_logo_2.ico"

[autoload]

SteamValues="*res://Scripts/Globals/SteamValues.gd"
Lobby="*res://Scripts/Globals/Lobby.gd"
PacketHandler="*res://Scripts/Globals/PacketHandler.gd"
PacketSender="*res://Scripts/Globals/PacketSender.gd"
RoomSettings="*res://Scripts/Globals/RoomSettings.gd"
SceneLoader="*res://Scenes/Game/SceneLoader.tscn"
Globals="*res://Scenes/Game/Globals.tscn"
Util="*res://Scripts/Globals/Util.gd"
CustomizePlayer="*res://Scenes/Game/CustomizePlayer.tscn"
GamemodeValues="*res://Scripts/Globals/GamemodeValues.gd"
UserSettings="*res://Scripts/Globals/UserSettings.gd"
MusicAndSfxHandler="*res://Scenes/Game/MusicAndSFXHandler.tscn"
CursorHandler="*res://Scripts/Globals/CursorHandler.gd"
AchievementHandler="*res://Scripts/Globals/AchievementHandler.gd"
ProfanityFilter="*res://Scripts/Util/ProfanityFilter.gd"
Steam="*res://Scripts/Globals/SteamStub.gd"

[debug]

gdscript/warnings/unused_signal=false
gdscript/warnings/unused_argument=false

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/always_on_top=true
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="2d"
window/stretch/aspect="keep_width"
mouse_cursor/custom_image="res://Assets/Images/Cursors/fish_cursor2.png"
window/size/fullscreen=true

[global]

display=false

